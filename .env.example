# Supabase → Project Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=""

# Direct connection (port 5432) — drizzle-kit push needs this one
DIRECT_URL=""

# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Set by trustHost in auth.config.ts, but harmless to set explicitly
AUTH_TRUST_HOST="true"

# Required by Auth.js in production mode (next start / Vercel).
# Also set via trustHost in src/auth.config.ts, so this is belt-and-braces.
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email ──────────────────────────────────────────────────────────
# Brevo verifies a single SENDER ADDRESS, so it delivers to anyone
# without owning a domain. 300/day free. Recommended.
#   1. brevo.com → sign up
#   2. Senders & IP → add your email → click the link they send you
#   3. SMTP & API → API Keys → create one
BREVO_API_KEY=""
MAIL_FROM="the-address-you-verified@gmail.com"
MAIL_FROM_NAME="NetQuest"

# Resend verifies a DOMAIN. Without one it only delivers to the address
# your Resend account was created with. Used as a fallback if Brevo is
# not configured.
RESEND_API_KEY=""

# ── Production seed only (npm run db:seed:prod) ──
# Never commit real values. Set these on the host, not in the repo.
SUPERADMIN_EMAIL="you@school.edu"
SUPERADMIN_PASSWORD="pick-something-long-and-unique"
SUPERADMIN_NAME="Your Name"

# The sample curriculum loads by default. Set to "false" to start empty.
# Test ACCOUNTS are never created by the production seed either way.
# SEED_SAMPLE_CONTENT="false"

# ── Image uploads ──────────────────────────────────────────────────
# Vercel → Storage → create a Blob store. Vercel injects this token
# automatically on deploy; copy it here for local development.
BLOB_READ_WRITE_TOKEN=""
